{
  "name": "eksaar-panchang",
  "version": "2.0.0-beta.1",
  "private": true,
  "description": "Offline Panchang with explicit calculation conventions and worldwide time zones",
  "author": "Gopala Subramanium",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "desktop": "electron .",
    "pack:desktop": "electron-builder --publish never",
    "mobile:sync": "cap sync",
    "check": "npm run test && npm run build && npm run test:browser",
    "icons": "node scripts/icons.mjs",
    "test:reference": "node scripts/compare.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.55.0",
    "sharp": "0.35.4",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.eksaar.panchang",
    "productName": "Eksaar Panchang",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.reference"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Gopala Subramanium"
    },
    "icon": "public/icon-512.png",
    "asar": true
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}
